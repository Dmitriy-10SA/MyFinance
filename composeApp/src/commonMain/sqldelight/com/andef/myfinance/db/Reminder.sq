CREATE TABLE reminder (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    text TEXT NOT NULL,
    date INTEGER NOT NULL,
    time INTEGER NOT NULL,
    repeat_type TEXT
);

CREATE INDEX reminder_repeat_type_date_idx ON reminder(repeat_type, date);

getReminderById:
SELECT * FROM reminder WHERE id = ?;

insertReminder:
INSERT OR REPLACE INTO reminder(text, date, time, repeat_type)
VALUES (?, ?, ?, ?);

updateReminder:
UPDATE reminder SET text = ?, date = ?, time = ?, repeat_type = ? WHERE id = ?;

deleteReminderById:
DELETE FROM reminder WHERE id = ?;

getRemindersBetween:
SELECT * FROM reminder
WHERE (repeat_type IS NULL AND date BETWEEN :startDate AND :endDate)
   OR (repeat_type IS NOT NULL AND date <= :endDate)
ORDER BY date DESC, time DESC;

getRemindersAsList:
SELECT * FROM reminder
WHERE date BETWEEN ? AND ?;

lastInsertRowId:
SELECT last_insert_rowid();
