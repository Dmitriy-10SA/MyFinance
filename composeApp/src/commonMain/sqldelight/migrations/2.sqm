-- Income
CREATE TABLE income_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    amount REAL NOT NULL,
    category TEXT NOT NULL,
    date INTEGER NOT NULL,
    note TEXT
);
INSERT INTO income_new (id, amount, category, date, note)
SELECT id, amount, category, date, note FROM income;
DROP TABLE income;
ALTER TABLE income_new RENAME TO income;

CREATE TABLE IF NOT EXISTS income_category (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title TEXT NOT NULL
);

-- Expense
CREATE TABLE expense_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    amount REAL NOT NULL,
    category TEXT NOT NULL,
    date INTEGER NOT NULL,
    note TEXT
);
INSERT INTO expense_new (id, amount, category, date, note)
SELECT id, amount, category, date, note FROM expense;
DROP TABLE expense;
ALTER TABLE expense_new RENAME TO expense;

CREATE TABLE IF NOT EXISTS expense_category (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    title TEXT NOT NULL
);

