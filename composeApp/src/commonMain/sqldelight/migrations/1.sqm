CREATE TABLE income (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    amount REAL NOT NULL,
    category INTEGER NOT NULL, -- enum ordinal
    date INTEGER NOT NULL,
    note TEXT
);

CREATE TABLE expense (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    amount REAL NOT NULL,
    category INTEGER NOT NULL, -- enum ordinal
    date INTEGER NOT NULL,
    note TEXT
);

CREATE TABLE reminder (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    text TEXT NOT NULL,
    date INTEGER NOT NULL,
    time INTEGER NOT NULL
);