CREATE TABLE reminder_new (
    id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
    text TEXT NOT NULL,
    date INTEGER NOT NULL,
    time INTEGER NOT NULL,
    repeat_type TEXT
);

INSERT INTO reminder_new (id, text, date, time, repeat_type)
SELECT id, text, date, time,
       CASE WHEN monthly = 1 THEN 'MONTHLY' ELSE NULL END
FROM reminder;

DROP TABLE reminder;

ALTER TABLE reminder_new RENAME TO reminder;

CREATE INDEX reminder_repeat_type_date_idx ON reminder(repeat_type, date);
